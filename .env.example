# Database
POSTGRES_USER=proposalcreator
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=proposalcreator
DATABASE_URL=postgresql://proposalcreator:secretpassword@localhost:5432/proposalcreator

# Security
SECRET_KEY=supersecretkeychangeinproduction

# AI Providers (get from anthropic.com and openai.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Provider for new workflow AI steps: claude | gemini
LLM_PROVIDER=claude

# n8n orchestration — shared secret between backend and n8n (any long random string).
# Leave empty to disable workflows and the /internal API.
N8N_SHARED_SECRET=
# Only needed when running the backend outside docker-compose:
# N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# BACKEND_INTERNAL_URL=http://host.docker.internal:8000   # n8n in docker
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000               # n8n on host; not localhost (Node picks IPv6 ::1)
